LLM_PROVIDER=openai
LLM_API_KEY=replace-me
# Optional override for any OpenAI-compatible upstream.
# LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
# Required for M1 persistence. Leave empty to keep console-only logging.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_cost_tracker
# Optional M3 budget alerts in USD. Omit either threshold to disable it.
# DAILY_BUDGET_USD=10.00
# MONTHLY_BUDGET_USD=200.00
# Optional webhook. Without it, alerts are written to the console.
# ALERT_WEBHOOK_URL=https://example.com/hooks/llm-budget
# Optional shared secret required from clients as a Bearer token.
# PROXY_API_KEY=replace-me
